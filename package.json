{
  "name": "nexus-crm-auth-demo",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/api"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev --workspace @nexus/api\" \"npm:dev --workspace @nexus/web\"",
